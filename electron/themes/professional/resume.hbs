<!doctype html>
<html lang="fr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{{#resume.basics}}{{name}}{{/resume.basics}}</title>
	<style>
		{{{css}}}
	</style>
</head>
<body>
	<div class="resume">
		{{#resume.basics}}
		<header class="header">
			<h1>{{name}}</h1>
			{{#if label}}<h2>{{label}}</h2>{{/if}}
			<div class="contact-line">
				{{#if email}}<span>{{email}}</span>{{/if}}
				{{#if phone}}<span>{{phone}}</span>{{/if}}
				{{#location}}{{#if city}}<span>{{city}}{{#if region}}, {{region}}{{/if}}{{/if}}{{/location}}
				{{#if url}}<span>{{url}}</span>{{/if}}
			</div>
		</header>
		{{/resume.basics}}

		{{#resume.basics}}
		{{#if summary}}
		<section class="section">
			<h3 class="section-title">Profil Professionnel</h3>
			<p class="summary">{{summary}}</p>
		</section>
		{{/if}}
		{{/resume.basics}}

		{{#if resume.work.length}}
		<section class="section">
			<h3 class="section-title">Experience Professionnelle</h3>
			{{#each resume.work}}
			<div class="entry">
				<div class="entry-row">
					<div>
						<div class="entry-title">{{position}}</div>
						{{#if name}}<div class="entry-organization">{{name}}</div>{{/if}}
					</div>
					<div class="entry-date">{{MY startDate}} — {{#if endDate}}{{MY endDate}}{{else}}Actuel{{/if}}</div>
				</div>
				{{#if location}}<div class="entry-location">{{location}}</div>{{/if}}
				{{#if summary}}<div class="entry-summary">{{summary}}</div>{{/if}}
				{{#if highlights.length}}
				<ul class="highlights">
					{{#each highlights}}
					<li>{{.}}</li>
					{{/each}}
				</ul>
				{{/if}}
			</div>
			{{/each}}
		</section>
		{{/if}}

		{{#if resume.education.length}}
		<section class="section">
			<h3 class="section-title">Formation</h3>
			{{#each resume.education}}
			<div class="entry">
				<div class="entry-row">
					<div>
						<div class="entry-title">{{studyType}}{{#if area}} — {{area}}{{/if}}</div>
						{{#if institution}}<div class="entry-organization">{{institution}}</div>{{/if}}
					</div>
					<div class="entry-date">{{Y startDate}}{{#if endDate}} — {{Y endDate}}{{/if}}</div>
				</div>
				{{#if score}}<div class="entry-summary">{{score}}</div>{{/if}}
			</div>
			{{/each}}
		</section>
		{{/if}}

		{{#if resume.skills.length}}
		<section class="section">
			<h3 class="section-title">Competences</h3>
			<div class="skills-grid">
				{{#each resume.skills}}
				<div class="skill-item">
					<strong>{{name}}:</strong> {{#each keywords}}{{.}}{{#unless @last}}, {{/unless}}{{/each}}
				</div>
				{{/each}}
			</div>
		</section>
		{{/if}}

		{{#if resume.projects.length}}
		<section class="section">
			<h3 class="section-title">Projets</h3>
			{{#each resume.projects}}
			<div class="entry">
				<div class="entry-row">
					<div class="entry-title">{{name}}</div>
					{{#if startDate}}<div class="entry-date">{{MY startDate}}{{#if endDate}} — {{MY endDate}}{{/if}}</div>{{/if}}
				</div>
				{{#if description}}<div class="entry-summary">{{description}}</div>{{/if}}
				{{#if highlights.length}}
				<ul class="highlights">
					{{#each highlights}}
					<li>{{.}}</li>
					{{/each}}
				</ul>
				{{/if}}
			</div>
			{{/each}}
		</section>
		{{/if}}

		<div class="two-col">
			{{#if resume.languages.length}}
			<section class="section">
				<h3 class="section-title">Langues</h3>
				<div class="languages-grid">
					{{#each resume.languages}}
					<div>{{language}}{{#if fluency}} — {{fluency}}{{/if}}</div>
					{{/each}}
				</div>
			</section>
			{{/if}}

			{{#if resume.interests.length}}
			<section class="section">
				<h3 class="section-title">Centres d'Interet</h3>
				<div>
					{{#each resume.interests}}
					<span>{{name}}{{#unless @last}}, {{/unless}}</span>
					{{/each}}
				</div>
			</section>
			{{/if}}
		</div>

		{{#if resume.awards.length}}
		<section class="section">
			<h3 class="section-title">Distinctions</h3>
			{{#each resume.awards}}
			<div class="entry">
				<strong>{{title}}</strong>{{#if awarder}} — {{awarder}}{{/if}}{{#if date}} ({{Y date}}){{/if}}
			</div>
			{{/each}}
		</section>
		{{/if}}
	</div>
</body>
</html>

<!doctype html>
<html lang="fr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{{#resume.basics}}{{name}}{{/resume.basics}}</title>
	<style>
		{{{css}}}
	</style>
</head>
<body>
	<div class="resume">
		{{#resume.basics}}
		<header class="header">
			<h1>{{name}}</h1>
			{{#if label}}<h2>{{label}}</h2>{{/if}}
			<div class="contact-bold">
				{{#if email}}<span>{{email}}</span>{{/if}}
				{{#if phone}}<span>{{phone}}</span>{{/if}}
				{{#location}}{{#if city}}<span>{{city}}{{#if region}}, {{region}}{{/if}}</span>{{/if}}{{/location}}
				{{#if url}}<span>{{url}}</span>{{/if}}
			</div>
		</header>
		{{/resume.basics}}

		{{#resume.basics}}
		{{#if summary}}
		<section class="section">
			<h3 class="section-title">PROFIL</h3>
			<p class="summary">{{summary}}</p>
		</section>
		{{/if}}
		{{/resume.basics}}

		{{#if resume.work.length}}
		<section class="section">
			<h3 class="section-title">EXPERIENCE</h3>
			{{#each resume.work}}
			<div class="entry">
				<div class="entry-bold-header">
					<div class="entry-row-bold">
						<div class="entry-title">{{position}}</div>
						<div class="entry-date">{{MY startDate}} — {{#if endDate}}{{MY endDate}}{{else}}ACTUEL{{/if}}</div>
					</div>
					{{#if name}}<div class="entry-subtitle">{{name}}{{#if location}} • {{location}}{{/if}}</div>{{/if}}
				</div>
				{{#if summary}}<div class="entry-summary">{{summary}}</div>{{/if}}
				{{#if highlights.length}}
				<ul class="highlights">
					{{#each highlights}}
					<li>{{.}}</li>
					{{/each}}
				</ul>
				{{/if}}
			</div>
			{{/each}}
		</section>
		{{/if}}

		{{#if resume.education.length}}
		<section class="section">
			<h3 class="section-title">FORMATION</h3>
			{{#each resume.education}}
			<div class="entry">
				<div class="entry-bold-header">
					<div class="entry-row-bold">
						<div class="entry-title">{{studyType}}{{#if area}} — {{area}}{{/if}}</div>
						<div class="entry-date">{{Y startDate}}{{#if endDate}} — {{Y endDate}}{{/if}}</div>
					</div>
					{{#if institution}}<div class="entry-subtitle">{{institution}}</div>{{/if}}
				</div>
				{{#if score}}<div class="entry-summary">{{score}}</div>{{/if}}
			</div>
			{{/each}}
		</section>
		{{/if}}

		{{#if resume.skills.length}}
		<section class="section">
			<h3 class="section-title">COMPETENCES</h3>
			<div class="skills-bold">
				{{#each resume.skills}}
				<div class="skill-bold">
					<strong>{{name}}</strong>
					<span>{{#each keywords}}{{.}}{{#unless @last}}, {{/unless}}{{/each}}</span>
				</div>
				{{/each}}
			</div>
		</section>
		{{/if}}

		{{#if resume.projects.length}}
		<section class="section">
			<h3 class="section-title">PROJETS</h3>
			{{#each resume.projects}}
			<div class="entry">
				<div class="entry-bold-header">
					<div class="entry-row-bold">
						<div class="entry-title">{{name}}</div>
						{{#if startDate}}<div class="entry-date">{{MY startDate}}{{#if endDate}} — {{MY endDate}}{{/if}}</div>{{/if}}
					</div>
				</div>
				{{#if description}}<div class="entry-summary">{{description}}</div>{{/if}}
			</div>
			{{/each}}
		</section>
		{{/if}}

		<div class="two-col-bold">
			{{#if resume.languages.length}}
			<section class="section">
				<h3 class="section-title">LANGUES</h3>
				<div class="list-bold">
					{{#each resume.languages}}
					<div>{{language}}{{#if fluency}} — {{fluency}}{{/if}}</div>
					{{/each}}
				</div>
			</section>
			{{/if}}

			{{#if resume.interests.length}}
			<section class="section">
				<h3 class="section-title">INTERETS</h3>
				<div class="list-bold">
					{{#each resume.interests}}
					{{name}}{{#unless @last}}, {{/unless}}
					{{/each}}
				</div>
			</section>
			{{/if}}
		</div>
	</div>
</body>
</html>
